{
  "name": "ocx-switcher",
  "productName": "OCX Switcher",
  "version": "1.0.0",
  "description": "Barre de tâches / plateau système pour switcher provider et modèle opencodex — Windows & Linux",
  "main": "main.js",
  "desktopName": "OCX Switcher",
  "author": {
    "name": "Gildas",
    "email": "appweb514@gmail.com"
  },
  "homepage": "https://github.com/appweb514-svg/ocx-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/appweb514-svg/ocx-manager.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --win --linux --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.ocxmanager.switcher",
    "productName": "OCX Switcher",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../server.mjs",
        "to": "server/server.mjs"
      },
      {
        "from": "../public",
        "to": "server/public"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon-codex-black.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OCX Switcher"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon-codex-black.png",
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "Switch provider/modèle opencodex depuis le plateau système"
    }
  }
}
